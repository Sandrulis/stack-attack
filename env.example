# Copy to .env.local and fill in from the Supabase project settings.
# Authentication → Providers → Google must be enabled.
# Add http://localhost:3177 (and the production origin) to Redirect URLs.

# Browser (Vite + Vercel). Safe to expose.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local only — so the agent can run `npm run db:migrate`. Do not put these on Vercel.
# Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_REGION=eu-west-1
# Optional, if the default pooler host does not connect:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
